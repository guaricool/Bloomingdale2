# --- NextAuth ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Base de datos ---
# Ruta al archivo SQLite. Por defecto se crea en ./data/bloomingdale.db
DATABASE_URL=./data/bloomingdale.db

# --- Idioma / zona horaria ---
LOCALE=es-MX
TIMEZONE=America/Chicago
