generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("member")
  memberId     Int?     @unique
  member       Member?  @relation(fields: [memberId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdAgendas Agenda[]
  createdEvents  Event[]
  posts          Post[]
}

model FamilyGroup {
  id           Int      @id @default(autoincrement())
  name         String
  headMemberId Int?     @unique
  headMember   Member?  @relation("FamilyHead", fields: [headMemberId], references: [id])
  members      Member[] @relation("FamilyMembers")
  createdAt    DateTime @default(now())
}

model Member {
  id               Int      @id @default(autoincrement())
  firstName        String
  lastName         String
  membershipNumber String?
  familyGroupId    Int?
  familyGroup      FamilyGroup? @relation("FamilyMembers", fields: [familyGroupId], references: [id])
  
  headOfFamily     FamilyGroup? @relation("FamilyHead")
  user             User?

  discourseLogs    DiscourseLog[]
  classesTaught    ClassSchedule[] @relation("ClassTeacher")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Organization {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  
  classSchedules ClassSchedule[]
}

model ClassSchedule {
  id             Int          @id @default(autoincrement())
  date           String       // YYYY-MM-DD
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lessonTitle    String
  manualUrl      String?
  teacherId      Int?
  teacher        Member?      @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
}

model Agenda {
  id        Int      @id @default(autoincrement())
  date      String   @unique // YYYY-MM-DD
  status    String   @default("draft")
  createdBy Int
  creator   User     @relation(fields: [createdBy], references: [id])
  
  items         AgendaItem[]
  discourseLogs DiscourseLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgendaItem {
  id       Int    @id @default(autoincrement())
  agendaId Int
  agenda   Agenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  type     String
  order    Int    @default(0)
  refId    Int?
  note     String?
}

model Hymn {
  number  Int     @id
  titleEs String
  titleEn String?
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  eventDate   String
  type        String   @default("actividad")
  createdBy   Int
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
}

model DiscourseLog {
  id            Int    @id @default(autoincrement())
  memberId      Int
  member        Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  agendaId      Int
  agenda        Agenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  discourseDate String // YYYY-MM-DD
  topic         String?
}

model Post {
  id        Int      @id @default(autoincrement())
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  title     String?
  body      String
  pinned    Int      @default(0)
  createdAt DateTime @default(now())
}
